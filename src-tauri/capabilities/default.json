{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Escopo mínimo image-first: ler/escrever só nas pastas de saída + sidecars ffmpeg/vips.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-remove-file",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$APPDATA/out/**" }
      ]
    },
    "shell:allow-execute",
    {
      "identifier": "shell:scope",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/vips",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
